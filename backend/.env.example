
# --- Email notifications (optional; leave blank to disable) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=1
MAIL_FROM=

# --- SMS notifications via Africa's Talking (optional) ---
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=
AT_SANDBOX=0

# --- Deposits ---
MIN_DEPOSIT_PERCENT=10
DEFAULT_DEPOSIT_PERCENT=30

# --- M-Pesa STK Push (Safaricom Daraja). Leave MPESA_CONSUMER_KEY empty to keep the manual "enter the code" flow. ---
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
# Any long random text. It becomes part of the callback URL so strangers cannot fake payments.
MPESA_CALLBACK_SECRET=
# Your public https address, e.g. https://kim597.pythonanywhere.com  (Safaricom must be able to reach it)
PUBLIC_APP_URL=
# Platform fee kept from each payout (0 = none)
COMMISSION_PERCENT=0
