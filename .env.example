# Copy to backend/.env
SECRET_KEY=change-this-to-a-long-random-string
FLASK_ENV=development            # set to "production" when deployed (secure cookies, requires SECRET_KEY + ADMIN_PASSWORD)
FLASK_DEBUG=1
DATABASE_URL=                    # blank = SQLite at backend/instance/app.db ; MySQL: mysql+pymysql://user:pass@host/db
PUBLIC_APP_URL=                  # your real deployed URL, shown in the footer/admin settings
ADMIN_EMAIL=admin@example.com    # administrator created by `python seed.py`
ADMIN_PASSWORD=                  # REQUIRED in production; dev default is used only in development
SEED_DEMO=1                      # 0 = create only categories + admin (no demo users)
SOCIAL_FACEBOOK=                 # optional: real social profile URLs; icons show only when set
SOCIAL_X=
SOCIAL_LINKEDIN=
SOCIAL_INSTAGRAM=
SESSION_TIMEOUT_MINUTES=120
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15
